<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Database Editor - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Poppins', Arial, sans-serif; background: #1a1a2e; color: #eee; min-height: 100vh; }
        .header { background: #16213e; padding: 20px; text-align: center; border-bottom: 2px solid #0f3460; }
        .header h1 { font-size: 22px; color: #e94560; }
        .tabs { display: flex; gap: 5px; padding: 15px 20px; background: #0f3460; flex-wrap: wrap; }
        .tabs button { padding: 8px 18px; border: none; border-radius: 20px; cursor: pointer; font-weight: 600; font-size: 13px; background: #16213e; color: #eee; }
        .tabs button.active { background: #e94560; color: white; }
        .table-container { padding: 20px; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th { background: #0f3460; padding: 10px; text-align: left; font-size: 11px; text-transform: uppercase; position: sticky; top: 0; }
        td { padding: 8px 10px; border-bottom: 1px solid #16213e; }
        tr:hover { background: rgba(233,69,96,0.1); }
        td[contenteditable] { cursor: text; outline: none; }
        td[contenteditable]:focus { background: rgba(233,69,96,0.2); border-radius: 4px; }
        .save-btn { background: #e94560; color: white; border: none; padding: 5px 12px; border-radius: 10px; cursor: pointer; font-size: 11px; }
        .delete-btn { background: #c0392b; color: white; border: none; padding: 5px 12px; border-radius: 10px; cursor: pointer; font-size: 11px; margin-left: 5px; }
        .search-box { width: 300px; padding: 8px 15px; border-radius: 20px; border: none; background: #16213e; color: white; margin: 10px 20px; }
        @media (max-width: 768px) { table { font-size: 11px; } th, td { padding: 6px; } }
    </style>
</head>
<body>
    <div class="header">
        <h1><i class="fas fa-database"></i> Database Editor</h1>
    </div>
    
    <div class="tabs">
        <button class="active" onclick="showTable('users')">Users (<%= tables.users.length %>)</button>
        <button onclick="showTable('duties')">Duties (<%= tables.duties.length %>)</button>
        <button onclick="showTable('notifications')">Notifications (<%= tables.notifications.length %>)</button>
        <button onclick="showTable('slides')">Slides (<%= tables.slides.length %>)</button>
    </div>
    
    <input type="text" class="search-box" id="searchInput" placeholder="🔍 Search..." oninput="filterTable()">
    
    <div class="table-container">
        <% ['users','duties','notifications','slides'].forEach(function(tableName, idx) { %>
        <div id="table-<%= tableName %>" class="table-wrapper" style="<%= idx === 0 ? '' : 'display:none;' %>">
            <% var data = tables[tableName]; %>
            <% if (data.length === 0) { %>
                <p style="text-align:center; padding:50px; color:#666;">No data in <%= tableName %></p>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <% Object.keys(data[0]).forEach(function(col) { %>
                                <th><%= col %></th>
                            <% }); %>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% data.forEach(function(row) { %>
                            <tr data-table="<%= tableName %>" data-id="<%= row.id || row.nombor_daftar || row[Object.keys(row)[0]] %>">
                                <% Object.keys(row).forEach(function(col) { %>
                                    <td contenteditable="true" data-col="<%= col %>"><%= row[col] !== null ? row[col] : '' %></td>
                                <% }); %>
                                <td>
                                    <button class="save-btn" onclick="saveRow(this)">Save</button>
                                    <button class="delete-btn" onclick="deleteRow(this)">Delete</button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>
        <% }); %>
    </div>

    <script>
        function showTable(name) {
            document.querySelectorAll('.table-wrapper').forEach(t => t.style.display = 'none');
            document.querySelectorAll('.tabs button').forEach(b => b.classList.remove('active'));
            document.getElementById('table-' + name).style.display = 'block';
            event.target.classList.add('active');
        }
        
        function filterTable() {
            var s = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('.table-wrapper:not([style*="display: none"]) tbody tr').forEach(function(row) {
                row.style.display = row.textContent.toLowerCase().includes(s) ? '' : 'none';
            });
        }
        
        function saveRow(btn) {
            var row = btn.closest('tr');
            var table = row.dataset.table;
            var id = row.dataset.id;
            var data = {};
            row.querySelectorAll('td[contenteditable]').forEach(function(td) {
                data[td.dataset.col] = td.textContent;
            });
            
            fetch('/api/db/update', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({table: table, id: id, data: data})
            }).then(r => r.json()).then(d => {
                if(d.success) { btn.textContent = '✓'; btn.style.background = '#27ae60'; setTimeout(() => { btn.textContent = 'Save'; btn.style.background = '#e94560'; }, 1500); }
            });
        }
        
        function deleteRow(btn) {
            if(!confirm('Delete this row permanently?')) return;
            var row = btn.closest('tr');
            var table = row.dataset.table;
            var id = row.dataset.id;
            
            fetch('/api/db/delete', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({table: table, id: id})
            }).then(r => r.json()).then(d => {
                if(d.success) row.remove();
            });
        }
    </script>
</body>
</html>