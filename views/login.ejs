<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - St. John Duty System</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Poppins', Arial, sans-serif;
            background: #f0ebe3;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .header {
            background: linear-gradient(135deg, #6B3F1F, #8B5E3C, #A0724A);
            color: white;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            box-shadow: 0 4px 20px rgba(107, 63, 31, 0.3);
        }

        .header-logo-school { 
            width: 40px; 
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3)); 
        }

        .header-logo-sjam { 
            width: 55px; 
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3)); 
        }

        .header-text { text-align: center; }

        .header-text h1 { 
            font-size: 26px; 
            font-weight: 800; 
            letter-spacing: 1px; 
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        .header-text p { 
            font-size: 13px; 
            margin-top: 5px; 
            font-weight: 300; 
            letter-spacing: 3px; 
        }

        @media (max-width: 768px) {
            .header-text h1 { font-size: 18px; }
        }
        .login-wrapper {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            background: linear-gradient(180deg, #f9f7f4, #f0ebe3);
        }
        
        .login-card {
            background: white;
            width: 420px;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.1);
            text-align: center;
            border: 1px solid rgba(139, 94, 60, 0.1);
            transition: all 0.3s;
        }
        
        .login-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 80px rgba(0,0,0,0.15);
        }
        
        .login-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #8B5E3C, #A0724A);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: white;
            font-size: 32px;
            box-shadow: 0 10px 30px rgba(139, 94, 60, 0.3);
        }
        
        .login-title {
            font-size: 28px;
            font-weight: 800;
            color: #5a3921;
            margin-bottom: 5px;
        }
        
        .login-subtitle {
            color: #888;
            font-size: 13px;
            margin-bottom: 30px;
            font-weight: 500;
            letter-spacing: 1px;
        }
        
        .form-label {
            display: block;
            text-align: left;
            margin-bottom: 6px;
            font-weight: 600;
            color: #5a3921;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .form-input {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid #e8e0d8;
            border-radius: 12px;
            font-size: 16px;
            margin-bottom: 20px;
            transition: all 0.3s;
            background: #fdfcfb;
            font-family: 'Poppins', sans-serif;
        }
        
        .form-input:focus {
            border-color: #8B5E3C;
            outline: none;
            box-shadow: 0 0 0 4px rgba(139, 94, 60, 0.1);
            background: white;
        }
        
        .login-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #8B5E3C, #A0724A);
            color: white;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 8px 25px rgba(139, 94, 60, 0.3);
        }
        
        .login-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(139, 94, 60, 0.5);
        }
        
        .error-msg {
            background: linear-gradient(135deg, #f8d7da, #f5c6cb);
            color: #721c24;
            padding: 12px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-weight: 500;
        }
        
        .footer {
            background: linear-gradient(135deg, #6B3F1F, #8B5E3C);
            color: white;
            text-align: center;
            padding: 20px;
        }
        
        @media (max-width: 480px) {
            .login-card { width: 100%; padding: 25px; }
            .header-text h1 { font-size: 18px; }
        }
    </style>
</head>
<body>

<div class="header">
    <img src="https://upload.wikimedia.org/wikipedia/commons/4/49/Lencana_Sekolah_SMKBJ.png" alt="School Logo" class="header-logo-school">
    <img src="https://sjam.org.my/wp-content/uploads/2019/05/SJAM-logo.png" alt="St John Logo" class="header-logo-sjam">
    <div class="header-text">
        <h1>DUTY HOURS RECORD</h1>
        <p>S M K &nbsp; B U K I T &nbsp; J A M B U L</p>
    </div>
</div>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-icon">
            <i class="fas fa-key"></i>
        </div>
        
        <h2 class="login-title">WELCOME BACK</h2>
        <p class="login-subtitle">ST. JOHN SMKBJ</p>
        
        <% if (error) { %>
            <div class="error-msg"><i class="fas fa-exclamation-triangle"></i> <%= error %></div>
        <% } %>
        
        <form action="/login" method="POST">
            <% if (typeof nombor_daftar !== 'undefined') { %>
                <input type="hidden" name="nombor_daftar" value="<%= nombor_daftar %>">
            <% } else { %>
                <label class="form-label">Nombor Daftar</label>
                <input type="text" name="nombor_daftar" class="form-input" 
                    placeholder="Enter your nombor daftar" required autofocus>
            <% } %>
            
            <% if (typeof requirePassword !== 'undefined' && requirePassword) { %>
                <label class="form-label">Admin Password</label>
                <input type="password" name="password" class="form-input" 
                    placeholder="Enter admin password" required autofocus>
            <% } %>
            
            <button type="submit" class="login-btn">
                <i class="fas fa-sign-in-alt"></i> Login
            </button>
        </form>
    </div>
</div>

<div class="footer">
    <p><strong>Copyright &copy; 2025-2026 : ST JOHN SMK BUKIT JAMBUL</strong></p>
    <p><strong>Digital Duty Record System</strong></p>
</div>

</body>
</html>