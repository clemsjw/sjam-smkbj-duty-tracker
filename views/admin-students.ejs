<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student's Records</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');
        
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Poppins', Arial, sans-serif; background: #f0ebe3; min-height: 100vh; }
        
        .content { padding: 30px; background: linear-gradient(180deg, #f9f7f4, #f0ebe3); min-height: 70vh; }
        
        .page-title {
            color: #5a3921; font-size: 22px; font-weight: 700; margin-bottom: 25px;
            padding-bottom: 12px; border-bottom: 3px solid;
            border-image: linear-gradient(135deg, #8B5E3C, #DBC4B8) 1;
        }
        
        .student-grid { display: flex; flex-wrap: wrap; gap: 20px; }
        
        .student-card {
            background: white; border-radius: 20px; padding: 25px; width: 320px;
            text-decoration: none; color: inherit; transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex; align-items: center; gap: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            border: 1px solid rgba(139, 94, 60, 0.1);
        }
        
        .student-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.15);
        }
        
        .student-avatar {
            width: 60px; height: 60px; border-radius: 50%;
            background: linear-gradient(135deg, #8B5E3C, #A0724A);
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 22px; flex-shrink: 0;
            box-shadow: 0 8px 20px rgba(139, 94, 60, 0.3);
        }
        
        .student-info h6 { color: #5a3921; font-size: 16px; font-weight: 700; margin: 0; }
        .student-info small { color: #888; font-size: 12px; display: block; margin-top: 3px; }
        .student-info code { font-size: 11px; color: #aaa; }
        
        .footer { background: linear-gradient(135deg, #6B3F1F, #8B5E3C); color: white; text-align: center; padding: 20px; }
        
        @media (max-width: 768px) {
            .student-card { width: 100%; }
            .header-text h1 { font-size: 18px; }
        }
    </style>
</head>
<body>

<%- include('partial/header', { currentPage: 'students', user: user }) %>
<div class="content">
<h3 class="page-title"><i class="fas fa-user-graduate"></i> Select Student to View Records</h3>

<div style="margin-bottom: 20px;">
    <input type="text" id="searchInput" placeholder="🔍 Search by name or nombor daftar..." 
           style="width: 100%; padding: 12px 18px; border: 2px solid #e8e0d8; border-radius: 12px; font-size: 14px; font-family: 'Poppins', sans-serif;">
</div>

<div class="student-grid" id="studentGrid">
        <% if (students.length === 0) { %>
            <div style="width:100%; text-align:center; padding:60px; color:#ccc;">
                <i class="fas fa-user-slash" style="font-size:60px;"></i>
                <p style="margin-top:15px; font-size:16px;">No students registered yet</p>
            </div>
        <% } %>
        
        <% students.forEach(student => { %>
            <a href="/admin/student/<%= student.nombor_daftar %>" class="student-card">
                <div class="student-avatar"><i class="fas fa-user"></i></div>
                <div class="student-info">
                    <h6><%= student.full_name %></h6>
                    <small><%= student.class || 'No Class' %></small>
                    <code><%= student.nombor_daftar %></code>
                </div>
            </a>
        <% }) %>
    </div>
</div>

<div class="footer">
    <p><strong>Copyright &copy; 2025-2026 : ST JOHN SMK BUKIT JAMBUL</strong></p>
    <p><strong>Digital Duty Record System</strong></p>
</div>

<script>
document.getElementById('searchInput').addEventListener('input', function() {
    var search = this.value.toLowerCase();
    document.querySelectorAll('.student-card').forEach(function(card) {
        var text = card.textContent.toLowerCase();
        card.style.display = text.includes(search) ? '' : 'none';
    });
});
</script>
</body>
</html>